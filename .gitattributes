# Default: treat everything as text and normalize EOL to LF
* text=auto eol=lf

# Markdown files: nice diffs
*.md diff=markdown

# PHP files: syntax-aware diffs
*.php diff=php

# JSON files: mark as text and normalize EOL
*.json text eol=lf

# YAML files: mark as text and normalize EOL
*.yml text eol=lf

# Shell scripts: mark as text, normalize EOL, and make executable
*.sh text eol=lf

# Composer & package files
composer.json text eol=lf
composer.lock text eol=lf

# Binary files (SVG is text: it keeps its diffs)
*.png binary

# Left out of the archive of the package (git archive)
#
# The package ships src/, config/twitch.php, database/ and composer.json. The development files and the
# tooling stay in the repository. docs/ is kept: docs/scripts/publish.sh builds the site from git archive.

# Folders
/assets export-ignore
/.gitlab export-ignore
/config/dev-tools export-ignore
/tests export-ignore

# Files
/.dependency-update.json export-ignore
/.editorconfig export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/.gitlab-ci.yml export-ignore
/.markdownlint.json export-ignore
/.markdownlintignore export-ignore
/CODE_OF_CONDUCT.md export-ignore
/CONTRIBUTING.md export-ignore
/Makefile export-ignore
/SECURITY.md export-ignore
/composer.lock export-ignore
