<?xml version="1.0" encoding="UTF-8" ?>
<phpdocumentor
    configVersion="3"
    title="zairakai/laravel-twitch"
    >
    <paths>
        <output>build/docs</output>
        <cache>build/phpdoc-cache</cache>
    </paths>
    <version number="latest">
        <api>
            <source dsn=".">
                <path>src</path>
            </source>
            <ignore hidden="true" symlinks="true">
                <path>src/**/*Test.php</path>
            </ignore>
        </api>
    </version>
</phpdocumentor>
